APP_ENV=development
APP_NAME=CampusFind
API_PREFIX=/api/v1
POSTGRES_DB=campusfind_db
POSTGRES_USER=campusfind_user
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SECRET_KEY=replace-with-a-long-random-local-secret
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
MATCH_HIGH_THRESHOLD=75
MATCH_MEDIUM_THRESHOLD=45
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@campusfind.local
